; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="action-rpg"
run/main_scene="uid://d1i5vducbt4uq"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

GlobalContants="*res://_globals/global_contants.gd"
GlobalLevelManager="*res://_globals/global_level_manager.gd"
GlobalEventBus="*res://_globals/global_event_bus.gd"
GlobalGameManager="*res://_globals/global_game_manager.gd"
PlayerHud="*res://hud/player_hud.tscn"
GlobalPlayerManager="*res://_globals/global_player_manager.gd"
GlobalPauseMenu="*res://hud/pause_menu.tscn"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=256
window/size/viewport_height=176
window/size/window_width_override=1024
window/size/window_height_override=704
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="action-rpg"

